      "denied": [
        {
          "id": "flight_status",
          "patterns": ["\\bestado (de|del) (mi |nuestro )?vuelo\\b", "\\bvuelo\\b.*\\b(retrasado|cancelado|a tiempo)\\b"]
        },
        {
          "id": "live_gate",
          "patterns": ["\\bqué puerta\\b.*\\bvuelo\\b", "\\b(mi|nuestro) vuelo\\b.*\\bpuerta\\b"]

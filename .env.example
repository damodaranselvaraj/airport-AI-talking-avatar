# --- LangSmith observability (default: enabled) ---
# Get a free API key at https://smith.langchain.com (5,000 traces/month free).
# Set LANGSMITH_TRACING=false to disable tracing.
# PRIVACY NOTE: question text appears in LangSmith via the LLM call inputs (LangChain default).
# Set LANGCHAIN_HIDE_INPUTS=true to redact all LLM inputs if required by your data policy.
# Free tier retains traces for 14 days; review langchain.com/privacy before going to production.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=dam-kiosk
# Standard (smith.langchain.com):
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# AWS-hosted (aws.smith.langchain.com) — use this if your URL starts with aws.smith...:
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com


# Copy to .env and fill in. .env is gitignored and loaded server-side only.

# --- Secrets (never sent to the browser) ---
OPENAI_API_KEY=sk-your-openai-key
TYPESAFE_API_KEY=your-typesafe-jev-key
COHERE_API_KEY=your-cohere-key

# --- OpenAI models ---
OPENAI_CHAT_MODEL=gpt-4o
# Supervisor intent classifier (only called for questions the policy rules did not already decide)
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536
OPENAI_MAX_TOKENS=8191

# --- Paths (defaults) ---
KNOWLEDGE_DIR=knowledge/dam-source-documents
CHROMA_DIR=chroma_db
FACES_DIR=faces

# --- Ingestion ---
# Path to the ingestion manifest. The repo ships it at data/manifest.json; set this so
# ingestion finds it without relying on the script's built-in fallback.
MANIFEST_PATH=data/manifest.json
DOCUMENT_ROOT=data
INGEST_DRY_RUN=false

# --- Chunking ---
CHUNKING_STRATEGY=markdown_headers_recursive
CHUNK_SIZE=300
CHUNK_OVERLAP=0
PRIMARY_HEADER_LEVEL=2

# --- Storage (defaults) ---
VECTOR_DB=chroma
CHROMA_COLLECTION=knowledge_base
BM25_INDEX_PATH=.bm25/knowledge_base.pkl

# --- Retrieval ---
# These values match the application defaults in config/settings.py. Increasing the
# *_TOP_K / RRF_K widths improves recall at higher latency and cost; keep .env in sync
# with settings.py so a fresh copy of this file reproduces the default behaviour.
EMBEDDING_PROVIDER=openai
DENSE_TOP_K=20
SPARSE_RETRIEVER=bm25
SPARSE_TOP_K=20
FUSION_METHOD=rrf
RRF_K=20
HYBRID_TOP_K=20

# --- Reranking ---
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-v3.5
RERANKER_TOP_K=10
RERANKER_MAX_CANDIDATES=50

# --- Voice (all CPU; Ditto owns the GPU) ---
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
MAX_AUDIO_SECONDS=20
MAX_AUDIO_BYTES=5000000
KOKORO_VOICE=af_heart
KOKORO_LANG=a
SESSIONS_DIR=sessions
AUDIO_TTL_SECONDS=600

# --- Workflow ---
POLICY_PATH=config/policy.json
RESPONSES_PATH=config/responses.json
EVIDENCE_THRESHOLDS_PATH=config/evidence_thresholds.json
ANSWER_PASSAGES=5
NODE_TIMEOUT_SECONDS=30
MAX_QUESTION_CHARS=500

# --- Kiosk ---
DEFAULT_LANGUAGE=en
SESSION_TIMEOUT_SECONDS=120

# --- Avatar: Ditto talking head (GPU; runs as a warm worker in its own conda env) ---
# Default: enabled. Set AVATAR_ENABLED=false to disable the avatar (text + spoken answer only, no video).
# Follow docs/ditto-setup.md for Ditto setup before enabling.
AVATAR_ENABLED=true
# Defaults to %USERPROFILE%\anaconda3\envs\ditto\python.exe; uncomment to override.
# DITTO_PYTHON=C:/Users/you/anaconda3/envs/ditto/python.exe
DITTO_WORKER_SCRIPT=scripts/ditto_worker.py
DITTO_REPO=third_party/ditto-talkinghead
DITTO_DATA_ROOT=checkpoints/ditto_pytorch
DITTO_CFG_PKL=checkpoints/ditto_cfg/v0.4_hubert_cfg_pytorch.pkl
# Longest side of the rendered video (default 1024; values under 256 are ignored). The
# worker reads this from the real process environment, NOT from this file: set it in the
# shell that starts the server, e.g. $env:DITTO_MAX_SIZE = "768" (smaller = faster).
AVATAR_STARTUP_TIMEOUT_SECONDS=180
# Give up on a turn's video after this long and fall back to text + Kokoro audio.
# Measured warm render is ~4x the audio length (see docs/ditto-setup.md).
# The page keeps polling after this and still offers a late video (up to 3x this long).
AVATAR_TIMEOUT_SECONDS=180
AVATAR_MAX_QUEUE=64
VIDEO_TTL_SECONDS=600
# At server start, render any missing fixed-phrase clips (greeting, refusals, guardrail
# messages ...) with the default concierge. The kiosk shows "Warming up" until they are
# done: about 10 minutes the first time, instant on restarts (clips are cached in
# cache/clips/ by concierge image and phrase text). Only the concierge has clips; a
# traveler's photo is only animated for grounded answers, live.
# false skips it (missing clips then render live); scripts/prerender_clips.py does it ahead of time.
CLIPS_PRERENDER_ON_START=true
# --- Traveler photos (kept for the session only) ---
MAX_FACE_BYTES=5000000
FACE_IDLE_WARN_SECONDS=30
FACE_IDLE_COUNTDOWN_SECONDS=15
FACE_TTL_BACKSTOP_SECONDS=60

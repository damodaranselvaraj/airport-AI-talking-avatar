# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / type-checking / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Vector store (regenerated by the ingestion job)
chroma_db/

# Sparse BM25 index (regenerated by the ingestion job)
.bm25/

# Consent-based session photos — never committed, never sent to the cloud
faces/

# Ditto model weights (~2.2 GB, downloaded locally)
checkpoints/

# Per-session artifacts (wav / mp4 / worker logs)
sessions/

# Pre-rendered phrase clips (regenerated by scripts/prerender_clips.py; custom-face clips are session-only)
cache/

# Vendored Ditto inference repo (re-clone; see docs/ditto-setup.md)
third_party/

# Kiro IDE workspace state (specs, config, agent hooks)
.kiro/

# Agent task scratch and generated audit/review reports
.agents/

# Logs
*.log

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
